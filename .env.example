# Host port published by Docker Compose (container always listens on 8000)
HOST_PORT=8000
# Maximum accepted request body size in bytes (default 10 MiB)
MAX_BODY_BYTES=10485760
# Default /commit proof format when the request omits proofMode:
# "standard" (legacy per-leaf proofs) or "compact" (deduplicated multi-leaf)
DEFAULT_PROOF_MODE=standard
